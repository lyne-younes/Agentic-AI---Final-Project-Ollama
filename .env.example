# Copy to .env and fill in. Read by docker-compose.yml, and by the backend when run locally.

POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study_assistant
# For running the backend outside Docker; docker-compose.yml points the container at `db` instead.
DATABASE_URL=postgresql+asyncpg://study:study@localhost:5432/study_assistant

# Origin the browser uses. Google redirect URI to register: ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI models run locally in Ollama (https://ollama.com); missing models are pulled on first start.
# For running the backend outside Docker (in Docker, set OLLAMA_DOCKER_URL to override).
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama model with tool calling, e.g. qwen3:14b or gpt-oss:20b with ~16 GB of (V)RAM.
CHAT_MODEL=qwen3:8b
# Thinking gives better answers but slower replies; turn it off on a CPU-only machine.
# CHAT_THINK=true
# CHAT_CONTEXT_TOKENS=16384
# CHAT_TIMEOUT_SECONDS=600
